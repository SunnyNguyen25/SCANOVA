# Client configuration (safe to expose in the Vite client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend OCR configuration.
# Runtime reads only this project's root .env file.
# Default command-line OCR engine: paddle, tesseract, or ai (Gemini vision).
OCR_ENGINE=paddle

# AI extraction configuration.
AI_PROVIDER=gemini
AI_MODEL=gemini/gemini-3.6-flash
# Retry only temporary Gemini 503/UNAVAILABLE responses; this is not a request timeout.
AI_RETRY_ATTEMPTS=3
AI_RETRY_BASE_DELAY_SECONDS=2

# Gemini credential (used when AI_PROVIDER=gemini).
GEMINI_API=
